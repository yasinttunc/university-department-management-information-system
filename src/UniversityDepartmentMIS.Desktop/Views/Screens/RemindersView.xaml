<UserControl x:Class="UniversityDepartmentMIS.Desktop.Views.Screens.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Reminders" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <DatePicker x:Name="DateInput" DockPanel.Dock="Left" Width="150" Margin="0,0,16,0"
                        AutomationProperties.Name="Reminder date" materialDesign:HintAssist.Hint="Date" />
            <Button x:Name="AddButton" DockPanel.Dock="Right" Content="ADD REMINDER" Margin="16,0,0,0" Click="AddButton_Click" />
            <TextBox x:Name="NoteInput" AutomationProperties.Name="Reminder note" materialDesign:HintAssist.Hint="What needs doing?" />
        </DockPanel>

        <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Foreground="#B00020" Visibility="Collapsed" Margin="0,0,0,8" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="DELETE" Style="{DynamicResource MaterialDesignOutlinedButton}"
                    IsEnabled="False" Click="DeleteButton_Click" />
            <TextBlock x:Name="CountText" Opacity="0.7" VerticalAlignment="Center" />
        </DockPanel>

        <DataGrid x:Name="RemindersGrid"
                  AutomationProperties.AutomationId="RemindersGrid"
                  AutomationProperties.Name="Reminders"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionChanged="RemindersGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding RemindOn, StringFormat={}{0:ddd d MMM yyyy}}" Width="160" />
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
