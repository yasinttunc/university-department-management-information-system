<UserControl x:Class="UniversityDepartmentMIS.Desktop.Views.Screens.AdvisingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Advising" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <ComboBox x:Name="AdvisorPicker"
                      AutomationProperties.Name="Advisor"
                      Width="320"
                      DisplayMemberPath="DisplayName"
                      materialDesign:HintAssist.Hint="Advisor"
                      SelectionChanged="AdvisorPicker_SelectionChanged" />
            <TextBlock x:Name="SummaryText"
                       AutomationProperties.Name="Advising summary"
                       VerticalAlignment="Center"
                       Margin="24,0,0,0"
                       Opacity="0.8" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="Evaluations are saved as soon as you choose them."
                   Opacity="0.6"
                   Margin="0,8,0,0" />

        <DataGrid x:Name="AdviseesGrid"
                  AutomationProperties.AutomationId="AdviseesGrid"
                  AutomationProperties.Name="Advisees"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Number" Binding="{Binding Student.StudentNumber}" IsReadOnly="True" />
                <DataGridTextColumn Header="Name" Binding="{Binding Student.FullName}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Year" Binding="{Binding Student.YearOfStudy}" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Evaluation" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Choices}"
                                      SelectedItem="{Binding Choice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Label"
                                      IsEnabled="{Binding CanEdit}"
                                      AutomationProperties.Name="Evaluation" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
