<UserControl x:Class="UniversityDepartmentMIS.Desktop.Views.Screens.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Users" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock x:Name="PolicyText" DockPanel.Dock="Top" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,16" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="2*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="UsersGrid"
                      Grid.Column="0"
                      AutomationProperties.AutomationId="UsersGrid"
                      AutomationProperties.Name="Users"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionChanged="UsersGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" />
                    <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Add a user" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox x:Name="UsernameInput" AutomationProperties.Name="New username" materialDesign:HintAssist.Hint="Username"
                         materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,12" />
                <PasswordBox x:Name="NewPasswordInput" AutomationProperties.Name="New user password" materialDesign:HintAssist.Hint="Password"
                             materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,12" />
                <ComboBox x:Name="RoleInput" AutomationProperties.Name="Role" materialDesign:HintAssist.Hint="Role"
                          materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,12" />
                <Button x:Name="AddButton" Content="ADD USER" HorizontalAlignment="Left" Click="AddButton_Click" />

                <TextBlock x:Name="ResetHeader" Text="Reset password" FontSize="16" FontWeight="SemiBold" Margin="0,32,0,8" />
                <PasswordBox x:Name="ResetPasswordInput" AutomationProperties.Name="Reset password" materialDesign:HintAssist.Hint="New password"
                             materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,12" IsEnabled="False" />
                <Button x:Name="ResetButton" Content="RESET PASSWORD" HorizontalAlignment="Left" IsEnabled="False"
                        Style="{DynamicResource MaterialDesignOutlinedButton}" Click="ResetButton_Click" />

                <ItemsControl x:Name="MessageList" AutomationProperties.Name="Messages" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
