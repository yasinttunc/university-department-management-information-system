<UserControl x:Class="UniversityDepartmentMIS.Desktop.Views.Screens.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="CardNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <UniformGrid Columns="4" Margin="-8,0">
                <materialDesign:Card x:Name="StudentsCard" Margin="8" Padding="16" Cursor="Hand" MouseLeftButtonUp="StudentsCard_Click"
                                     AutomationProperties.Name="Students card">
                    <StackPanel>
                        <TextBlock Text="Students" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="StudentsNumber" Style="{StaticResource CardNumber}" />
                        <TextBlock Text="across four years of study" Opacity="0.7" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Margin="8" Padding="16" Cursor="Hand" MouseLeftButtonUp="StudentsCard_Click"
                                     AutomationProperties.Name="Students by year card">
                    <StackPanel>
                        <TextBlock Text="Students by year" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <ItemsControl x:Name="YearBars">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Value="{Binding Count, Mode=OneWay}" Maximum="{Binding Max, Mode=OneWay}" Height="10" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Margin="8" Padding="16" Cursor="Hand" MouseLeftButtonUp="CoursesCard_Click"
                                     AutomationProperties.Name="Section occupancy card">
                    <StackPanel>
                        <TextBlock Text="Average section occupancy" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="OccupancyNumber" Style="{StaticResource CardNumber}" />
                        <TextBlock x:Name="OccupancyDetail" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Margin="8" Padding="16" Cursor="Hand" MouseLeftButtonUp="AdvisingCard_Click"
                                     AutomationProperties.Name="Advising card">
                    <StackPanel>
                        <TextBlock Text="Advisees per advisor" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="AdvisingNumber" Style="{StaticResource CardNumber}" />
                        <TextBlock x:Name="AdvisingDetail" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="ALL REMINDERS" Style="{DynamicResource MaterialDesignFlatButton}" Click="RemindersButton_Click" />
                            <TextBlock Text="Next reminders" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl x:Name="RemindersList" AutomationProperties.Name="Next reminders">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <TextBlock DockPanel.Dock="Left" Width="110" Text="{Binding RemindOn, StringFormat={}{0:ddd d MMM yyyy}}" Opacity="0.7" />
                                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoReminders" Text="Nothing coming up." Opacity="0.6" Visibility="Collapsed" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="CALENDAR" Style="{DynamicResource MaterialDesignFlatButton}" Click="CalendarButton_Click" />
                            <TextBlock Text="Next events" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl x:Name="EventsList" AutomationProperties.Name="Next events">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <TextBlock DockPanel.Dock="Left" Width="110" Text="{Binding Date, StringFormat={}{0:ddd d MMM yyyy}}" Opacity="0.7" />
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoEvents" Text="Nothing coming up." Opacity="0.6" Visibility="Collapsed" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
