<UserControl x:Class="UniversityDepartmentMIS.Desktop.Views.Screens.CoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Courses &amp; sections" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <ComboBox x:Name="LevelFilter"
                          DockPanel.Dock="Top"
                          AutomationProperties.Name="Year level filter"
                          Width="150"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,12"
                          materialDesign:HintAssist.Hint="Year level"
                          SelectionChanged="LevelFilter_SelectionChanged" />
                <DataGrid x:Name="CoursesGrid"
                          AutomationProperties.AutomationId="CoursesGrid"
                          AutomationProperties.Name="Courses"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionChanged="CoursesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" />
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Year" Binding="{Binding YearLevel}" />
                        <DataGridTextColumn Header="Credits" Binding="{Binding Credits, TargetNullValue=-}" />
                        <DataGridTextColumn Header="ECTS" Binding="{Binding Ects, TargetNullValue=-}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="SectionsHeader" Grid.Row="0" Text="Sections" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8" />
                <DataGrid x:Name="SectionsGrid"
                          Grid.Row="1"
                          AutomationProperties.AutomationId="SectionsGrid"
                          AutomationProperties.Name="Sections"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionChanged="SectionsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Section" Binding="{Binding SectionNumber}" />
                        <DataGridTextColumn Header="Room" Binding="{Binding Room, TargetNullValue=-}" />
                        <DataGridTextColumn Header="Lecturer" Binding="{Binding LecturerName, TargetNullValue='Not assigned'}" Width="*" />
                        <DataGridTextColumn Header="Enrolled" Binding="{Binding Enrolled}" />
                        <DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" />
                        <DataGridTemplateColumn Header="Occupancy" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Value="{Binding OccupancyPercent, Mode=OneWay}" Maximum="100" Height="8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding OccupancyPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="2" Margin="0,16,0,8" LastChildFill="False">
                    <TextBlock x:Name="ClassListHeader" Text="Class list" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="AssignButton"
                            DockPanel.Dock="Right"
                            Content="ASSIGN STUDENTS"
                            IsEnabled="False"
                            Click="AssignButton_Click" />
                </DockPanel>
                <DataGrid x:Name="ClassListGrid"
                          Grid.Row="3"
                          AutomationProperties.AutomationId="ClassListGrid"
                          AutomationProperties.Name="Class list"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Number" Binding="{Binding StudentNumber}" />
                        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="Year" Binding="{Binding YearOfStudy}" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
