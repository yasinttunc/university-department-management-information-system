<UserControl x:Class="UniversityDepartmentMIS.Desktop.Views.Screens.TimetableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Timetable" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <ComboBox x:Name="StaffPicker"
                      AutomationProperties.Name="Lecturer"
                      Width="320"
                      DisplayMemberPath="DisplayName"
                      materialDesign:HintAssist.Hint="Lecturer"
                      SelectionChanged="StaffPicker_SelectionChanged" />
            <TextBlock x:Name="SummaryText"
                       AutomationProperties.Name="Timetable summary"
                       VerticalAlignment="Center"
                       Margin="24,0,0,0"
                       Opacity="0.8" />
        </DockPanel>

        <TextBlock x:Name="OutsideText"
                   DockPanel.Dock="Bottom"
                   Foreground="#B00020"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="Collapsed" />

        <Grid x:Name="WeekGrid" AutomationProperties.Name="Week grid" />
    </DockPanel>
</UserControl>
