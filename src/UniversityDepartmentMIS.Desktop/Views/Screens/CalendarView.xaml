<UserControl x:Class="UniversityDepartmentMIS.Desktop.Views.Screens.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Calendar" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="2*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button x:Name="PreviousButton" DockPanel.Dock="Left" Style="{DynamicResource MaterialDesignIconButton}"
                            AutomationProperties.Name="Previous month" ToolTip="Previous month" Click="PreviousButton_Click">
                        <materialDesign:PackIcon Kind="ChevronLeft" />
                    </Button>
                    <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{DynamicResource MaterialDesignIconButton}"
                            AutomationProperties.Name="Next month" ToolTip="Next month" Click="NextButton_Click">
                        <materialDesign:PackIcon Kind="ChevronRight" />
                    </Button>
                    <TextBlock x:Name="MonthText" AutomationProperties.Name="Month" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DockPanel>
                <UniformGrid x:Name="DayNames" DockPanel.Dock="Top" Columns="7" Margin="0,0,0,4" />
                <UniformGrid x:Name="DaysGrid" Columns="7" AutomationProperties.Name="Days" />
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock x:Name="SelectedDayText" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="AddButton" Content="ADD EVENT" Margin="0,0,8,0" Click="AddButton_Click" />
                    <Button x:Name="EditButton" Content="EDIT" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"
                            IsEnabled="False" Click="EditButton_Click" />
                    <Button x:Name="DeleteButton" Content="DELETE" Style="{DynamicResource MaterialDesignOutlinedButton}"
                            IsEnabled="False" Click="DeleteButton_Click" />
                </StackPanel>
                <ListBox x:Name="EventsList" AutomationProperties.Name="Events on the selected day"
                         SelectionChanged="EventsList_SelectionChanged" MouseDoubleClick="EditButton_Click">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Description}" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
