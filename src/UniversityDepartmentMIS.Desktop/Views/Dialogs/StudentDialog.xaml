<Window x:Class="UniversityDepartmentMIS.Desktop.Views.Dialogs.StudentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Student"
        Width="680"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource AppForegroundBrush}"
        FontFamily="Segoe UI">
    <DockPanel Margin="24">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DeleteButton"
                    Content="DELETE"
                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                    Margin="0,0,8,0"
                    Click="DeleteButton_Click" />
            <Button x:Name="CancelButton"
                    Content="CANCEL"
                    IsCancel="True"
                    Style="{DynamicResource MaterialDesignFlatButton}"
                    Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="SAVE" IsDefault="True" Click="SaveButton_Click" />
        </StackPanel>

        <ItemsControl x:Name="ErrorList"
                      DockPanel.Dock="Bottom"
                      AutomationProperties.Name="Form errors"
                      Foreground="#B00020"
                      Margin="0,8,0,0" />

        <UniformGrid Columns="2">
            <TextBox x:Name="NumberInput" AutomationProperties.Name="Student number" materialDesign:HintAssist.Hint="Student number" materialDesign:HintAssist.IsFloating="True" Margin="0,0,16,16" />
            <TextBox x:Name="NationalIdInput" AutomationProperties.Name="National ID" materialDesign:HintAssist.Hint="National ID (9 digits)" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,16" />
            <TextBox x:Name="FirstNameInput" AutomationProperties.Name="First name" materialDesign:HintAssist.Hint="First name" materialDesign:HintAssist.IsFloating="True" Margin="0,0,16,16" />
            <TextBox x:Name="LastNameInput" AutomationProperties.Name="Last name" materialDesign:HintAssist.Hint="Last name" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,16" />
            <TextBox x:Name="EmailInput" AutomationProperties.Name="Email" materialDesign:HintAssist.Hint="Email" materialDesign:HintAssist.IsFloating="True" Margin="0,0,16,16" />
            <TextBox x:Name="PhoneInput" AutomationProperties.Name="Phone" materialDesign:HintAssist.Hint="Phone (optional)" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,16" />
            <TextBox x:Name="AddressInput" AutomationProperties.Name="Address" materialDesign:HintAssist.Hint="Address (optional)" materialDesign:HintAssist.IsFloating="True" Margin="0,0,16,16" />
            <TextBox x:Name="ProgrammeInput" AutomationProperties.Name="Programme" materialDesign:HintAssist.Hint="Programme" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,16" />
            <ComboBox x:Name="YearInput" AutomationProperties.Name="Year of study" materialDesign:HintAssist.Hint="Year of study" materialDesign:HintAssist.IsFloating="True" Margin="0,0,16,16" />
            <TextBox x:Name="EnrolmentYearInput" AutomationProperties.Name="Enrolment year" materialDesign:HintAssist.Hint="Enrolment year" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,16" />
            <ComboBox x:Name="AdvisorInput" AutomationProperties.Name="Advisor" materialDesign:HintAssist.Hint="Advisor" materialDesign:HintAssist.IsFloating="True" DisplayMemberPath="DisplayName" Margin="0,0,16,16" />
        </UniformGrid>
    </DockPanel>
</Window>
