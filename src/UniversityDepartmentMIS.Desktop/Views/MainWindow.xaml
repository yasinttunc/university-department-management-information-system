<Window x:Class="UniversityDepartmentMIS.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="University Department MIS"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource AppForegroundBrush}"
        FontFamily="Segoe UI">
    <DockPanel>
        <materialDesign:ColorZone DockPanel.Dock="Top" Mode="PrimaryMid" Padding="16,10">
            <DockPanel>
                <Button x:Name="SignOutButton"
                        DockPanel.Dock="Right"
                        Content="SIGN OUT"
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Foreground="White"
                        BorderBrush="White"
                        VerticalAlignment="Center"
                        Click="SignOutButton_Click" />
                <StackPanel DockPanel.Dock="Right" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="UserText" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    <TextBlock x:Name="DepartmentText" HorizontalAlignment="Right" FontSize="12" Opacity="0.85" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="School" Width="28" Height="28" VerticalAlignment="Center" />
                    <TextBlock Text="University Department MIS" FontSize="18" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <Border DockPanel.Dock="Left"
                Width="230"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource AppDividerBrush}">
            <ListBox x:Name="MenuList"
                     AutomationProperties.Name="Main menu"
                     Margin="0,8,0,0"
                     SelectionChanged="MenuList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <materialDesign:PackIcon Kind="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <ContentControl x:Name="ScreenHost" Focusable="False" />
    </DockPanel>
</Window>
