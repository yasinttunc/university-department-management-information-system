<Window x:Class="UniversityDepartmentMIS.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Sign in - University Department MIS"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource AppForegroundBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="32">
        <materialDesign:PackIcon Kind="School"
                                 Width="56"
                                 Height="56"
                                 HorizontalAlignment="Center"
                                 Foreground="{DynamicResource AppPrimaryBrush}" />
        <TextBlock Text="University Department MIS"
                   FontSize="22"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,4" />
        <TextBlock Text="Sign in to continue"
                   HorizontalAlignment="Center"
                   Opacity="0.7"
                   Margin="0,0,0,24" />

        <TextBox x:Name="UsernameInput"
                 AutomationProperties.Name="Username"
                 materialDesign:HintAssist.Hint="Username"
                 Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                 Margin="0,0,0,16" />
        <PasswordBox x:Name="PasswordInput"
                     AutomationProperties.Name="Password"
                     materialDesign:HintAssist.Hint="Password"
                     Style="{DynamicResource MaterialDesignOutlinedPasswordBox}"
                     Margin="0,0,0,8" />

        <TextBlock x:Name="ErrorText"
                   AutomationProperties.Name="Sign-in error"
                   Foreground="#B00020"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,4,0,8" />

        <Button x:Name="SignInButton"
                Content="SIGN IN"
                IsDefault="True"
                Height="40"
                Margin="0,8,0,0"
                Click="SignInButton_Click" />
    </StackPanel>
</Window>
